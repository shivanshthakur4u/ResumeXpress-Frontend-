# ─── Backend API ──────────────────────────────────────────────────────────────
# Base URL of the ResumeXpress backend. Must end with a trailing slash, because
# request paths are joined onto it relatively (e.g. "resume/getResumes").
NEXT_PUBLIC_BACKEND_URL=http://localhost:5055/api/v1/

# ─── Site ─────────────────────────────────────────────────────────────────────
# Public origin of this frontend, used to build shareable resume links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── A note on AI keys ────────────────────────────────────────────────────────
# There is deliberately no AI key here.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle that ships
# to the browser, so a key placed here is readable by every visitor. AI calls now
# go through the backend, which holds GOOGLE_AI_API_KEY server-side.
#
# If you previously set NEXT_PUBLIC_GOOGLE_AI_API_KEY, treat that key as
# compromised: revoke it in Google AI Studio and issue a new one for the backend.
